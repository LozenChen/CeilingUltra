<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	<LangVersion>10.0</LangVersion>
	<CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('../../Celeste.dll')">../..</CelestePrefix>
	<CelestePrefix Condition="'$(CelestePrefix)' == ''">lib-stripped</CelestePrefix>
	  
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>$(AssemblyName)</Authors>
    <RootNamespace>Celeste.Mod.CeilingUltra</RootNamespace>
    <Configurations>Release</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <!-- Optional: when set, the built mod is deployed into a Celeste Mods directory.
         Empty by default, so a plain build only produces bin\<Configuration>\net8.0.
         Example: dotnet build -c Release -p:CelestePrefix="D:\Games\...\Celeste" -p:DeployDir="D:\Games\...\Celeste\Mods\CeilingUltra" -->
    <DeployDir Condition="'$(DeployDir)' == ''"></DeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <PackageReference IncludeAssets="compile" />
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="$(CelestePrefix)\Celeste.dll" Publicize="true" />
	<Reference Include="$(CelestePrefix)\FNA.dll" />
	<Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" />
    <Reference Include="GravityHelper">
      <HintPath>Libs\GravityHelper.dll</HintPath>
    </Reference>
    <Reference Include="MaxHelpingHand">
      <HintPath>Libs\MaxHelpingHand.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>Libs\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>Libs\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MonoMod.Utils" Version="22.7.31.1" />
    <Reference Include="YamlDotNet">
      <HintPath>Libs\YamlDotNet.dll</HintPath>
      <Private>False</Private>
    </Reference>

  </ItemGroup>
	
	<PropertyGroup>
		<PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
	</PropertyGroup>
	<ItemGroup>
		<Publicize Include="Celeste" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="MonoMod.Utils" />
	</ItemGroup>
	
  <ItemGroup>
    <Compile Remove="Libs\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Libs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Libs\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Graphics\Atlases\Gameplay\CeilingUltra\" />
  </ItemGroup>

  <!-- Deploy the mod layout everest.yaml expects: everest.yaml + bin\<Configuration>\net8.0\<DLL>
       + Dialog + Graphics + Loenn + Tutorials. The .pdb is deliberately not copied:
       replacing it at runtime makes Everest's FileSystemModContent throw on hot reload. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <_DeployDialog Include="$(MSBuildProjectDirectory)\Dialog\**\*" />
      <_DeployGraphics Include="$(MSBuildProjectDirectory)\Graphics\**\*" />
      <_DeployLoenn Include="$(MSBuildProjectDirectory)\Loenn\**\*" />
      <_DeployTutorials Include="$(MSBuildProjectDirectory)\Tutorials\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\everest.yaml" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)\bin\$(Configuration)\$(TargetFramework)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployDialog)" DestinationFiles="@(_DeployDialog->'$(DeployDir)\Dialog\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployGraphics)" DestinationFiles="@(_DeployGraphics->'$(DeployDir)\Graphics\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployLoenn)" DestinationFiles="@(_DeployLoenn->'$(DeployDir)\Loenn\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployTutorials)" DestinationFiles="@(_DeployTutorials->'$(DeployDir)\Tutorials\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName) -> $(DeployDir)" />
  </Target>


			
</Project>
